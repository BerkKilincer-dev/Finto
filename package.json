{
  "name": "finto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"web,voice\" --prefix-colors \"blue,magenta\" --kill-others-on-fail false \"npm:dev:web\" \"npm:dev:voice\"",
    "dev:web": "tsx backend/server.ts",
    "dev:voice": "python ai/voice_assistant.py",
    "build": "vite build frontend --config frontend/vite.config.ts",
    "start": "cross-env NODE_ENV=production tsx backend/server.ts",
    "preview": "vite preview frontend --config frontend/vite.config.ts",
    "clean": "rimraf frontend/dist",
    "lint": "tsc --project frontend/tsconfig.json --noEmit",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate-thresholds": "tsx scripts/backtest-thresholds.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.6"
  }
}
